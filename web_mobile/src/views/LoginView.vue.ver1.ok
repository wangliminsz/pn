	min-height: 100vh;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: calc(32px + env(safe-area-inset-top)) 28px calc(32px + env(safe-area-inset-bottom));
	background:
		radial-gradient(90% 55% at 50% 8%, rgba(234, 88, 12, 0.07) 0%, transparent 56%),
		#121916;
}

.login-main {
	width: 100%;
	max-width: 370px;
}

.brand-orb {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 7px;
	width: 116px;
	height: 116px;
	margin: 0 auto 58px;
	border-radius: 50%;
	background: linear-gradient(145deg, #ff7a1a 0%, #ea580c 58%, #c2410c 100%);
	color: #fff;
	box-shadow: 0 18px 48px rgba(234, 88, 12, 0.24);
}

.brand-orb svg {
	width: 42px;
	height: 42px;
}

.brand-orb span {
	font-size: 8px;
	font-weight: 600;
	letter-spacing: 1.5px;
	opacity: 0.96;
}

.login-form {
	width: 100%;
}

.simple-field {
	display: flex;
	align-items: center;
	gap: 15px;
	min-height: 64px;
	border-bottom: 1px solid #2a3631;
	color: #8b958f;
	transition: border-color 180ms ease;
}

.simple-field:focus-within {
	border-bottom-color: #39d7a7;
}

.simple-field + .simple-field {
	margin-top: 8px;
}

.simple-field input {
	flex: 1;
	min-width: 0;
	height: 62px;
	padding: 0;
	border: 0;
	outline: 0;
	background: transparent;
	color: #f1f5f2;
	font-size: 19px;
	font-weight: 400;
}

.simple-field input::placeholder {
	color: #c4cbc6;
	opacity: 1;
}

.password-toggle {
	display: inline-flex;
	flex: 0 0 auto;
	align-items: center;
	justify-content: center;
	width: 36px;
	height: 36px;
	padding: 0;
	border: 0;
	border-radius: 50%;
	background: transparent;
	color: #8b958f;
	transition:
		color 180ms ease,
		background 180ms ease;
}

.password-toggle:hover {
	color: #d7ded9;
	background: rgba(255, 255, 255, 0.05);
}

.password-toggle:focus-visible {
	outline: 2px solid #39d7a7;
	outline-offset: 2px;
}

.captcha-field {
	padding-right: 2px;
}

.captcha-img {
	flex: 0 0 auto;
	width: 104px;
	height: 40px;
	padding: 0 6px;
	overflow: hidden;
	border: 1px solid #2a3631;
	border-radius: 8px;
	background: #18211d;
}

.captcha-img img {
	display: block;
	width: 100%;
	height: 38px;
	object-fit: contain;
}

.error-box {
	display: flex;
	align-items: flex-start;
	gap: 8px;
	padding: 10px 12px;
	margin-top: 20px;
	border: 1px solid rgba(245, 108, 108, 0.24);
	border-radius: 10px;
	background: rgba(245, 108, 108, 0.08);
	color: #ffaaaa;
	font-size: 12px;
	line-height: 1.45;
}

.login-btn {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	width: 100%;
	height: 58px;
	margin-top: 46px;
	padding: 0 22px;
	border: 0;
	border-radius: 999px;
	background: linear-gradient(180deg, #3cdcac 0%, #29c795 100%);
	color: #06251c;
	font-size: 16px;
	font-weight: 600;
	letter-spacing: 0.6px;
	box-shadow: 0 14px 34px rgba(41, 199, 149, 0.2);
	transition:
		opacity 180ms ease,
		transform 180ms ease,
		box-shadow 180ms ease;
}

.login-btn:hover:not(:disabled) {
	box-shadow: 0 16px 38px rgba(41, 199, 149, 0.3);
}

.login-btn:active:not(:disabled) {
	transform: scale(0.985);
}

.login-btn:disabled {
	opacity: 0.7;
}

@media (max-height: 700px) {
	.brand-orb {
		width: 96px;
		height: 96px;
		margin-bottom: 38px;
	}

	.brand-orb svg {
		width: 34px;
		height: 34px;
	}

	.login-btn {
		margin-top: 32px;
	}
}
</style>
