<template>
	<div class="page property-page">
		<header class="topbar">
			<div class="brand-mini">
				<BrandMark :size="34" />
				<span>pro<b>Notify</b></span>
			</div>
			<button class="account-btn" type="button" @click="accountVisible = true">
				<span class="account-avatar">{{ auth.initial }}</span>
				<Icon name="chevronDown" :size="14" />
			</button>
		</header>

		<section class="page-head">
			<p class="eyebrow">PROPERTY</p>
			<h1>Property management</h1>
			<p class="subtitle"><strong>{{ total }}</strong> {{ total === 1 ? 'room' : 'rooms' }} · tap a card to edit</p>
		</section>

		<section class="search-row">
			<van-search
				v-model="keyword"
				shape="round"
				background="transparent"
				placeholder="Search room name"
				:clearable="false"
				@search="reset"
			>
				<template #left-icon>
					<Icon name="search" :size="17" />
				</template>
				<template #right-icon>
					<button
						v-if="keyword"
						type="button"
						class="search-clear"
						aria-label="Clear search"
						@click.stop="clearSearch"
					>
						<Icon name="x" :size="15" />
					</button>
				</template>
			</van-search>
			<button class="go-btn" type="button" :disabled="loading" @click="reset">Go</button>
		</section>

		<van-pull-refresh v-model="refreshing" :disabled="loading" @refresh="onRefresh">
			<van-list
				ref="listRef"
				v-model:loading="loading"
				v-model:finished="finished"
				:offset="140"
				finished-text=""
				@load="onLoad"
			>
				<div v-if="items.length" class="cards">
					<article
						v-for="p in items"
						:key="p.id"
						class="property-card"
						role="button"
						tabindex="0"
						@click="edit(p)"
						@keydown.enter="edit(p)"
					>
						<div class="card-stripe" :class="{ expired: isExpired(p) }"></div>
						<div class="card-head">
							<div class="card-title">
								<h3>{{ p.name }}</h3>
								<div class="badges">
									<span class="chip blue">{{ periodLabel(p.pay_period) }}</span>
									<span v-if="isExpired(p)" class="chip red">Expired</span>
								</div>
							</div>
							<div v-if="p.rent_amount !== null && p.rent_amount !== undefined && p.rent_amount !== ''" class="rent-block">
								<span class="currency">฿</span>
								<strong>{{ money(p.rent_amount) }}</strong>
							</div>
							<div v-else class="rent-block empty-rent">
								<span class="currency">฿</span>
								<strong>—</strong>
							</div>
						</div>

						<div class="info-list">
							<div class="info-row">
								<Icon name="calendar" :size="14" />
								<span class="info-label">Lease</span>
								<span class="info-value">{{ p.rent_start || '—' }} <span class="arrow">→</span> {{ p.rent_end || '—' }}</span>
							</div>
							<div class="info-row">
								<Icon name="bell" :size="14" />
								<span class="info-label">Reminder</span>
								<span class="info-value">{{ periodLabel(p.pay_period) }} · day {{ p.remind_day || 1 }}</span>
							</div>
							<div v-if="p.group_id" class="info-row group-row">
								<Icon name="chat" :size="14" />
								<span class="info-label">Group</span>
								<span class="info-value mono group-id" :title="p.group_id">{{ p.group_id }}</span>
							</div>
							<div v-if="p.line_bot_name" class="info-row">
								<Icon name="bot" :size="14" />
								<span class="info-label">Line bot</span>
								<span class="info-value ellipsis">{{ p.line_bot_name }}</span>
							</div>
						</div>

						<div class="card-foot">
							<div class="owner">
								<span class="owner-avatar">{{ initial(p.owner_name) }}</span>
								<span class="ellipsis">{{ p.owner_name || 'Unassigned' }}</span>
							</div>
							<div class="card-actions">
								<button class="mini-btn" type="button" @click.stop="edit(p)">
									<Icon name="pencil" :size="13" />
									Edit
								</button>
								<button
									class="mini-btn danger"
									type="button"
									:disabled="deletingId === p.id"
									@click.stop="askDelete(p)"
								>
									<van-loading v-if="deletingId === p.id" size="12" color="#F56C6C" />
									<Icon v-else name="trash" :size="13" />
									Delete
								</button>
							</div>
						</div>
					</article>
				</div>

				<div v-else-if="loading" class="cards" aria-label="Loading properties">
					<div v-for="n in 3" :key="n" class="skeleton-card">
						<div class="skeleton-line w40"></div>
						<div class="skeleton-line w70"></div>
						<div class="skeleton-line w55"></div>
						<div class="skeleton-line w85"></div>
					</div>
				</div>

				<div v-else-if="finished" class="empty-state">
					<div class="empty-icon"><Icon :name="keyword ? 'search' : 'building'" :size="26" /></div>
					<h3>{{ keyword ? 'No matching properties' : 'No properties yet' }}</h3>
					<p>
						{{
							keyword
								? 'Try another room name, owner or group ID.'
								: 'Add your first room to track rent, lease dates and reminders.'
						}}
					</p>
					<button v-if="keyword" class="btn-ghost" type="button" @click="clearSearch">Clear search</button>
					<button v-else class="btn-primary empty-cta" type="button" @click="create">
						<Icon name="plus" :size="17" />
						Add property
					</button>
				</div>
			</van-list>
		</van-pull-refresh>

		<button class="fab" type="button" @click="create">
			<Icon name="plus" :size="20" />
			<span>Add property</span>
		</button>

		<van-action-sheet
			v-model:show="accountVisible"
			:actions="accountActions"
			:description="accountDescription"
			cancel-text="Cancel"
			@select="onAccountAction"
		/>
	</div>
</template>

<script setup lang="ts">
import { computed, nextTick, ref } from 'vue';
import { useRouter } from 'vue-router';
import { showConfirmDialog, showFailToast, showSuccessToast } from 'vant';
import { deleteProperty, listProperties } from '@/api/property';
import { useAuthStore } from '@/stores/auth';
import { errorMessage } from '@/utils/errors';
import BrandMark from '@/components/BrandMark.vue';
import Icon from '@/components/Icon.vue';

const router = useRouter();
const auth = useAuthStore();

const items = ref<any[]>([]);
const total = ref(0);
const page = ref(1);
const keyword = ref('');
const deletingId = ref<number | string | null>(null);
const loading = ref(false);
const finished = ref(false);
const refreshing = ref(false);
const listRef = ref<any>(null);
const accountVisible = ref(false);

const pageSize = 10;
let requestSeq = 0;

const PERIOD_LABELS: Record<string, string> = {
	Monthly: 'Monthly',
	Quarterly: 'Quarterly',
	HalfYear: 'Half year',
	Yearly: 'Yearly',
};

const accountActions = [{ name: 'Sign out', color: '#F56C6C' }];

const accountDescription = computed(() => {
	const name = auth.user?.name || auth.user?.username || auth.displayName;
	const tenant = auth.user?.tenant_name;
	return tenant ? `${name} · ${tenant}` : name;
});

function periodLabel(value: string) {
	return PERIOD_LABELS[value] || value || 'Monthly';
}

function money(value: number | string) {
	const number = Number(value);
	return Number.isFinite(number) ? number.toLocaleString('en-US') : '—';
}

function initial(name?: string) {
	return (name || 'U').trim().charAt(0).toUpperCase();
}

function isExpired(property: any) {
	if (!property?.rent_end) return false;
	const end = new Date(`${String(property.rent_end).slice(0, 10)}T23:59:59`);
	if (Number.isNaN(end.getTime())) return false;
	return end.getTime() < new Date(new Date().toDateString()).getTime();
}

async function onLoad() {
	const seq = ++requestSeq;
	const currentPage = page.value;
	try {
		const res: any = await listProperties({
			page: currentPage,
			limit: pageSize,
			name: keyword.value.trim(),
		});
		if (seq !== requestSeq) return;
		const data = Array.isArray(res.data) ? res.data : [];
		items.value = currentPage === 1 ? data : items.value.concat(data);
		total.value = Number(res.total || 0);
		page.value = currentPage + 1;
		finished.value = !res.is_next || data.length === 0;
	} catch (err) {
		if (seq === requestSeq) {
			finished.value = true;
			showFailToast(errorMessage(err, 'Could not load properties'));
		}
	} finally {
		if (seq === requestSeq) loading.value = false;
	}
}

function reset() {
	requestSeq += 1;
	page.value = 1;
	total.value = 0;
	items.value = [];
	finished.value = false;
	loading.value = false;
	nextTick(() => listRef.value?.check());
}

async function onRefresh() {
	refreshing.value = true;
	requestSeq += 1;
	page.value = 1;
	finished.value = false;
	loading.value = true;
	try {
		await onLoad();
	} finally {
		refreshing.value = false;
	}
}

function clearSearch() {
	keyword.value = '';
	reset();
}

function create() {
	router.push({ name: 'property-create' });
}

function edit(property: any) {
	router.push({ name: 'property-edit', params: { id: property.id } });
}

async function askDelete(property: any) {
	try {
		await showConfirmDialog({
			title: 'Delete property?',
			message: `"${property.name}" and its reminders and files will be permanently removed.`,
			confirmButtonText: 'Delete',
			confirmButtonColor: '#F56C6C',
		});
	} catch {
		return;
	}

	deletingId.value = property.id;
	try {
		await deleteProperty(property.id);
		items.value = items.value.filter((item) => item.id !== property.id);
		total.value = Math.max(0, total.value - 1);
		showSuccessToast('Property deleted');
		if (items.value.length === 0) reset();
	} catch (err) {
		showFailToast(errorMessage(err, 'Delete failed'));
	} finally {
		deletingId.value = null;
	}
}

function onAccountAction(action: { name: string }) {
	accountVisible.value = false;
	if (action.name === 'Sign out') {
		auth.signOut();
		router.replace({ name: 'login' });
	}
}

</script>

