	position: sticky;
	top: 0;
	z-index: 12;
	display: grid;
	grid-template-columns: 40px minmax(0, 1fr) auto;
	align-items: center;
	gap: 11px;
	padding: calc(12px + env(safe-area-inset-top)) 16px 12px;
	background: rgba(23, 23, 23, 0.92);
	border-bottom: 1px solid var(--pn-border);
	backdrop-filter: blur(16px);
}

