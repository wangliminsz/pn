	min-width: 0;
	line-height: 1.2;
}

.topbar-title span {
	display: block;
	color: var(--pn-text-strong);
	font-size: 13.5px;
	font-weight: 600;
}

.topbar-title strong {
	display: block;
	margin-top: 2px;
	overflow: hidden;
	color: var(--pn-faint);
	font-size: 10px;
	font-weight: 400;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.save-text {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 52px;
	min-height: 38px;
	padding: 0 12px;
	border: 1px solid rgba(64, 158, 255, 0.3);
	border-radius: 10px;
	background: rgba(64, 158, 255, 0.1);
	color: #8dc5ff;
	font-size: 12.5px;
	font-weight: 600;
	transition:
		background 180ms ease,
		border-color 180ms ease;
}

.save-text:hover:not(:disabled) {
	border-color: rgba(64, 158, 255, 0.48);
	background: rgba(64, 158, 255, 0.16);
}

.save-text:disabled {
	opacity: 0.6;
}

.form-loading {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12px;
	padding: 80px 20px;
	color: var(--pn-muted);
	font-size: 12px;
}

.form-body {
	padding: 18px 18px 0;
}

.form-hero {
	display: flex;
	align-items: flex-start;
	gap: 13px;
	padding: 17px;
	margin-bottom: 20px;
	border: 1px solid var(--pn-border);
	border-radius: 16px;
	background:
		linear-gradient(140deg, rgba(64, 158, 255, 0.08) 0%, transparent 55%),
		var(--pn-card);
}

.hero-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 0 0 auto;
	width: 42px;
	height: 42px;
	border: 1px solid rgba(64, 158, 255, 0.22);
	border-radius: 13px;
	background: rgba(64, 158, 255, 0.1);
	color: #8dc5ff;
}

.hero-copy {
	min-width: 0;
}

.eyebrow {
	color: #8dc5ff;
	font-size: 9px;
	font-weight: 600;
	letter-spacing: 1.35px;
}

.hero-copy h1 {
	margin-top: 3px;
	overflow: hidden;
	color: var(--pn-text-strong);
	font-size: 18px;
	font-weight: 600;
	letter-spacing: -0.35px;
	line-height: 1.3;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.hero-copy p:last-child {
	margin-top: 5px;
	color: var(--pn-muted);
	font-size: 11.5px;
	line-height: 1.5;
}

.error-box {
	display: flex;
	align-items: flex-start;
	gap: 8px;
	padding: 10px 12px;
	margin-bottom: 18px;
	border: 1px solid rgba(245, 108, 108, 0.24);
	border-radius: 10px;
	background: rgba(245, 108, 108, 0.08);
	color: #ffaaaa;
	font-size: 12px;
	line-height: 1.45;
}

.form-section {
	margin-bottom: 21px;
}

.section-head {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	margin-bottom: 9px;
	padding: 0 3px;
}

.section-head h2 {
	color: var(--pn-muted);
	font-size: 10px;
	font-weight: 600;
	letter-spacing: 1.35px;
	text-transform: uppercase;
}

.section-head span {
	color: var(--pn-faint);
	font-size: 9.5px;
	letter-spacing: 0.2px;
}

.section-hint {
	padding: 8px 4px 0;
	color: var(--pn-faint);
